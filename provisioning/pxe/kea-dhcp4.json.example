{
  "Dhcp4": {
    "interfaces-config": {
      "interfaces": [ "eth0" ]
    },
    "lease-database": {
      "type": "memfile",
      "persist": true,
      "name": "/var/lib/kea/dhcp4.leases"
    },
    "client-classes": [
      {
        "name": "iPXE UEFI/CREATE",
        "test": "option[user-class].exists and substring(option[user-class].hex,0,4) == 'iPXE' and option[client-system].hex == 0x0007",
        "boot-file-name": "http://10.100.0.10:8080/ipxe-create",
        "only-if-required": true
      },
      {
        "name": "iPXE UEFI/JOIN",
        "test": "option[user-class].exists and substring(option[user-class].hex,0,4) == 'iPXE' and option[client-system].hex == 0x0007",
        "boot-file-name": "http://10.100.0.10:8080/ipxe-join",
        "only-if-required": true
      },
      {
        "name": "PXE UEFI",
        "test": "not option[user-class].exists and option[client-system].hex == 0x0007",
        "next-server": "10.100.0.10",
        "boot-file-name": "ipxe.efi"
      }
    ],
    "subnet4": [
      {
        "id": 1,
        "subnet": "10.100.0.0/24",
        "pools": [
          {
            "pool": "10.100.0.100 - 10.100.0.109",
            "require-client-classes": [ "iPXE UEFI/CREATE" ]
          },
          {
            "pool": "10.100.0.110 - 10.100.0.199",
            "require-client-classes": [ "iPXE UEFI/JOIN" ]
          }
        ],
        "option-data": [
          {
            "name": "domain-name-servers",
            "data": "10.100.0.1"
          },
          {
            /* CRITICAL: option 3 (routers) MUST be set; Harvester installation fails without a default route */
            "name": "routers",
            "data": "10.100.0.1"
          }
        ],
        "reservations": [
          {
            "hw-address": "52:54:00:6b:13:e2",
            "ip-address": "10.100.0.101"
          }
        ]
      }
    ]
  }
}
